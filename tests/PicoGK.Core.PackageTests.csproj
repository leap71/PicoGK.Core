<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PicoGKPackageTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PicoGKPackageVersion>3.0.0-alpha.1</PicoGKPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PackageSmokeTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PicoGK.Core" Version="$(PicoGKPackageVersion)" />
  </ItemGroup>

</Project>
